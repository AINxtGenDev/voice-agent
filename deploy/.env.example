# Copy to deploy/.env (mode 0600, never commit). Contains the DuckDNS token and UI password hash.
DUCKDNS_DOMAIN=voicehpe
DUCKDNS_TOKEN=
ACME_EMAIL=
# Staging for rate-limit-free tests: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Host port published to 443 in the container; forward this one on the router
HTTPS_PORT=10556
# Hash from: docker run --rm caddy:2-alpine caddy hash-password  (single-quote it: it contains $)
UI_USER=
UI_PASSWORD_HASH=''
# Private host paths, outside the Git checkout
SECRETS_DIR=
DATA_DIR=
REPORTS_DIR=
ENABLE_TELEPHONY=true
MAX_CALL_SECONDS=300
